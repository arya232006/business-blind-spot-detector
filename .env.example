# Copy to .env and edit. Never commit .env.
# --- Database ---------------------------------------------------------
# Default (if unset): SQLite file at data/blindspot.db
# DATABASE_URL=sqlite:///data/blindspot.db
# DATABASE_URL=postgresql+psycopg2://blindspot:blindspot@localhost:5432/blindspot

# --- App wiring -------------------------------------------------------
# local = Streamlit calls the service layer directly (simplest). api = Streamlit calls the FastAPI backend.
BLINDSPOT_MODE=local
BLINDSPOT_API_URL=http://localhost:8000

# --- CORS ---------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated, NO wildcards: the API has no authentication).
# Add your deployed Next.js frontend, e.g. https://my-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501

# --- NLP models -------------------------------------------------------
# sbert = SentenceTransformers (downloads ~90MB model once). tfidf = fully offline lightweight fallback.
EMBEDDING_BACKEND=sbert
EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_BERTOPIC=true
# Optional Hugging Face transformer sentiment alongside VADER (slower, downloads a model)
USE_TRANSFORMER_SENTIMENT=false
TRANSFORMER_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
RANDOM_SEED=42

# --- Optional LLM for natural-language recommendation wording ---------
# Core analytics work without any LLM. Leave blank to disable.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Misc -------------------------------------------------------------
LOG_LEVEL=INFO
HTTP_TIMEOUT=15
MAX_UPLOAD_MB=25
